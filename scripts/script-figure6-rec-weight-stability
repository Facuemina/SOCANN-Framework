#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Figure 6 simulation script: 2D parameter sweep over feedforward (alpha_J) and
recurrent (alpha_W) weight-decay coefficients during simultaneous FF + REC
Hebbian learning in a 1D CANN.

Defaults match the legacy ALPHAS_STABLE launcher (from_stable=True,
alpha_J in logspace(-1.5, 2.1, 7), alpha_W in logspace(-1.5, 4.1, 10),
eta_J = eta_W = 1e-6, dt = 0.005, m = 0.2, tau = 0.015, tau_v = 0.6).

Saves top-level parameters, 2D sweep summary arrays, and per-pair subfolders
(`alphaJ-{i}_alphaW-{j}/`) outside the repository at:
    <repo_root>/../figure6-learning-ff-rec-alphas-data/
"""

import argparse
import os
import sys
import time
from functools import partial
from pathlib import Path

os.environ.setdefault("XLA_PYTHON_CLIENT_PREALLOCATE", "false")

import jax
import jax.numpy as jnp
import numpy as np
from tqdm import tqdm

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.append(str(REPO_ROOT))

from src.engine import gaussian, run_learning_ff_and_rec
from src.helpers import moving_average, sort_connectivity_matrix
from src.theory import learned_U_std, learned_weight_std, theoretical_speed


@partial(jax.jit, static_argnames=("g", "T", "T0"))
def _run_learning_ff_and_rec_jit(
    U0,
    V0,
    W_ff0,
    W_rec0,
    x0,
    v,
    inv_tau,
    inv_tauv,
    m,
    k,
    g,
    gain,
    learning_params,
    pos,
    T,
    T0=0,
):
    """Module-level JIT wrapper to prevent per-chunk recompilation."""
    neural_params = (inv_tau, inv_tauv, m, k, g, gain)
    return run_learning_ff_and_rec(
        U0,
        V0,
        W_ff0,
        W_rec0,
        x0,
        v,
        neural_params,
        learning_params,
        pos,
        T,
        T0=T0,
    )


def _safe_corrcoef(a, b):
    """Compute Pearson correlation between flattened arrays, returning NaN if constant."""
    a_flat = np.asarray(a, dtype=np.float64).ravel()
    b_flat = np.asarray(b, dtype=np.float64).ravel()
    if np.std(a_flat) == 0.0 or np.std(b_flat) == 0.0:
        return float("nan")
    return float(np.corrcoef(a_flat, b_flat)[0, 1])


def _generate_varying_speed_profile(
    total_steps,
    dt,
    m,
    tau,
    tauv,
    std_u,
    rng,
    win=150,
    speed_variation_pctg=0.4,
):
    """Generate smooth OU-filtered varying speed trajectory (host NumPy array)."""
    vel_eq = float(theoretical_speed(m, tau, tauv, std_u))
    vel_std = vel_eq / 3.0
    n_raw = total_steps + win - 1
    vels = np.empty(n_raw, dtype=np.float64)
    vels[0] = vel_eq
    noise = rng.normal(size=n_raw) * vel_std
    tau_speed = dt / 5.0

    for t in range(1, n_raw):
        vels[t] = vels[t - 1] + tau_speed * (vel_eq - vels[t - 1] + noise[t])

    min_vel = vel_eq * (1.0 - speed_variation_pctg / 2.0)
    max_vel = vel_eq * (1.0 + speed_variation_pctg / 2.0)
    v_min, v_max = vels.min(), vels.max()
    if v_max > v_min:
        vels = (vels - v_min) / (v_max - v_min) * (max_vel - min_vel) + min_vel
    else:
        vels.fill(vel_eq)

    vels_smooth = np.asarray(moving_average(vels, win), dtype=np.float32)
    return vels_smooth, vel_eq, vel_std, win


def parse_args():
    parser = argparse.ArgumentParser(
        description="2D (alpha_J, alpha_W) stability/learning sweep for FF + REC CANN."
    )

    # Network & neural dynamics (legacy alpha-sweep launcher + fun_learning defaults)
    parser.add_argument("--n", type=int, default=512, help="Number of neurons.")
    parser.add_argument("--dt", type=float, default=0.005, help="Euler time step (s).")
    parser.add_argument("--tau", type=float, default=0.015, help="Membrane time constant (s).")
    parser.add_argument("--tauv", type=float, default=0.6, help="Adaptation time constant (s).")
    parser.add_argument("--m", type=float, default=0.2, help="Adaptation strength m.")
    parser.add_argument("--k", type=float, default=0.1, help="Divisive inhibition constant.")
    parser.add_argument("--g", type=float, default=2.0, help="Activation exponent / type.")
    parser.add_argument("--gain", type=float, default=1.0, help="Activation gain.")

    # Input & plasticity parameters
    parser.add_argument("--input_std", type=float, default=5.0, help="Input bump std sigma_R.")
    parser.add_argument("--R0", type=float, default=30.0, help="Input amplitude A_R.")
    parser.add_argument("--J0", type=float, default=0.001, help="Reference FF scale J0.")
    parser.add_argument("--W0", type=float, default=0.0001, help="Reference REC scale W0.")
    parser.add_argument("--etaJ", type=float, default=1e-6, help="FF learning rate.")
    parser.add_argument("--etaW", type=float, default=1e-6, help="REC learning rate.")
    parser.add_argument("--betaJ", type=float, default=1.0, help="FF weight decay exponent.")
    parser.add_argument("--betaW", type=float, default=1.0, help="REC weight decay exponent.")
    parser.add_argument(
        "--v",
        type=float,
        default=None,
        help="Stimulus speed (default: theoretical_speed(m, tau, tauv, input_std)).",
    )

    # (alpha_J, alpha_W) log-spaced sweep grids (legacy num=2 active defaults)
    parser.add_argument("--alphaJ_log_min", type=float, default=-1.5, help="log10(min alpha_J).")
    parser.add_argument("--alphaJ_log_max", type=float, default=2.1, help="log10(max alpha_J).")
    parser.add_argument("--num_alphaJ", type=int, default=7, help="Number of alpha_J grid points.")
    parser.add_argument("--alphaW_log_min", type=float, default=-1.5, help="log10(min alpha_W).")
    parser.add_argument("--alphaW_log_max", type=float, default=4.1, help="log10(max alpha_W).")
    parser.add_argument("--num_alphaW", type=int, default=10, help="Number of alpha_W grid points.")
    parser.add_argument(
        "--alphaJ_indices",
        type=int,
        nargs="+",
        default=None,
        help="Optional subset of alpha_J indices (0-based) to run.",
    )
    parser.add_argument(
        "--alphaW_indices",
        type=int,
        nargs="+",
        default=None,
        help="Optional subset of alpha_W indices (0-based) to run.",
    )

    # Initialization, duration & speed mode
    parser.add_argument(
        "--init_mode",
        type=str,
        choices=("stable", "random"),
        default="stable",
        help="Weight initialization: 'stable' (Jeq, Weq; legacy fromstable='yes') or 'random'.",
    )
    parser.add_argument(
        "--stab_steps",
        type=int,
        default=5000,
        help="Warm-up stabilization steps (eta=0) used when --init_mode=stable.",
    )
    parser.add_argument(
        "--early_stop_corr",
        type=float,
        default=0.2,
        help="Early-stop threshold for stable init when both corr_ff and corr_rec drop below it "
        "(set <= 0 to disable).",
    )
    parser.add_argument("--chunks", type=int, default=100, help="Number of simulation chunks.")
    parser.add_argument(
        "--steps_per_chunk",
        type=int,
        default=1_500_000,
        help="Euler steps per chunk (legacy fun_learning default: 1.5e6).",
    )
    parser.add_argument(
        "--varying_speed",
        action="store_true",
        help="Use smooth time-varying speed profile instead of constant speed.",
    )
    parser.add_argument(
        "--av",
        type=float,
        default=None,
        help="Speed modulation parameter (default: 0.15 if --varying_speed else 0.0).",
    )
    parser.add_argument("--seed", type=int, default=42, help="Base random seed.")

    # Output & checkpointing controls
    parser.add_argument(
        "--output_dir",
        type=Path,
        default=REPO_ROOT.parent / "figure6-learning-ff-rec-alphas-data",
        help="Directory outside repository where data will be saved.",
    )
    parser.add_argument(
        "--save_every",
        type=int,
        default=0,
        help="Save weight snapshot every N chunks (0 = initial and final only, matching legacy saveiterations=0).",
    )
    parser.add_argument(
        "--skip_existing",
        action="store_true",
        help="Skip (alphaJ, alphaW) pairs that already have a final_state.npz file.",
    )

    return parser.parse_args()


def main():
    args = parse_args()

    n = args.n
    dt = args.dt
    tau = args.tau
    tauv = args.tauv
    m = args.m
    k = args.k
    g = args.g
    gain = args.gain
    input_std = args.input_std
    R0 = args.R0
    J0 = args.J0
    W0 = args.W0
    etaJ = args.etaJ
    etaW = args.etaW
    betaJ = args.betaJ
    betaW = args.betaW
    chunks = args.chunks
    steps = args.steps_per_chunk
    from_stable = args.init_mode == "stable"
    av = args.av if args.av is not None else (0.15 if args.varying_speed else 0.0)

    # Derived spatial scales & equilibrium speed
    std_U = float(learned_U_std(betaJ, input_std))
    std_J = float(learned_weight_std(betaJ, input_std))
    std_W = float(learned_weight_std(betaW, std_U / np.sqrt(2.0)))
    L = float(np.round(np.sqrt(2.0) * 10.0 * std_U))
    v_default = (
        float(args.v)
        if args.v is not None
        else float(theoretical_speed(m, tau, tauv, input_std))
    )

    alphaJ_vals = np.logspace(args.alphaJ_log_min, args.alphaJ_log_max, args.num_alphaJ, dtype=np.float64)
    alphaW_vals = np.logspace(args.alphaW_log_min, args.alphaW_log_max, args.num_alphaW, dtype=np.float64)

    alphaJ_indices = args.alphaJ_indices if args.alphaJ_indices is not None else list(range(len(alphaJ_vals)))
    alphaW_indices = args.alphaW_indices if args.alphaW_indices is not None else list(range(len(alphaW_vals)))

    output_dir = Path(args.output_dir).resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    # Top-level parameter dictionary
    sim_params = {
        "n": n,
        "dt": dt,
        "tau": tau,
        "tauv": tauv,
        "m": m,
        "k": k,
        "g": g,
        "gain": gain,
        "input_std": input_std,
        "R0": R0,
        "J0": J0,
        "W0": W0,
        "etaJ": etaJ,
        "etaW": etaW,
        "betaJ": betaJ,
        "betaW": betaW,
        "std_U": std_U,
        "std_J": std_J,
        "std_W": std_W,
        "L": L,
        "v": v_default,
        "alphaJ_vals": alphaJ_vals,
        "alphaW_vals": alphaW_vals,
        "chunks": chunks,
        "steps_per_chunk": steps,
        "total_steps": chunks * steps,
        "init_mode": args.init_mode,
        "from_stable": from_stable,
        "stab_steps": args.stab_steps,
        "early_stop_corr": args.early_stop_corr,
        "varying_speed": args.varying_speed,
        "av": av,
        "seed": args.seed,
        "save_every": args.save_every,
    }
    np.save(output_dir / "sim_params.npy", sim_params)

    # Pre-allocate or reload 2D summary grids so partial/resumed runs stay intact
    grid_shape = (len(alphaJ_vals), len(alphaW_vals))
    summary_path = output_dir / "sweep_summary.npz"
    if summary_path.exists():
        prev = np.load(summary_path, allow_pickle=True)
        final_corr_ff = np.asarray(prev["final_corr_ff"], dtype=np.float64)
        final_corr_rec = np.asarray(prev["final_corr_rec"], dtype=np.float64)
        final_j_max = np.asarray(prev["final_j_max"], dtype=np.float64)
        final_w_max = np.asarray(prev["final_w_max"], dtype=np.float64)
        chunks_done_grid = np.asarray(prev["chunks_completed"], dtype=np.int32)
        if final_corr_ff.shape != grid_shape:
            final_corr_ff = np.full(grid_shape, np.nan, dtype=np.float64)
            final_corr_rec = np.full(grid_shape, np.nan, dtype=np.float64)
            final_j_max = np.full(grid_shape, np.nan, dtype=np.float64)
            final_w_max = np.full(grid_shape, np.nan, dtype=np.float64)
            chunks_done_grid = np.zeros(grid_shape, dtype=np.int32)
    else:
        final_corr_ff = np.full(grid_shape, np.nan, dtype=np.float64)
        final_corr_rec = np.full(grid_shape, np.nan, dtype=np.float64)
        final_j_max = np.full(grid_shape, np.nan, dtype=np.float64)
        final_w_max = np.full(grid_shape, np.nan, dtype=np.float64)
        chunks_done_grid = np.zeros(grid_shape, dtype=np.int32)

    # Spatial grid and analytical equilibrium templates
    pos = jnp.linspace(0.0, L, n, endpoint=False).reshape((n, 1))
    Jeq = gaussian(pos, pos.T, std_J, L)
    Weq = gaussian(pos, pos.T, std_W, L) * (1.0 - jnp.eye(n))
    Jeq_np = np.asarray(Jeq, dtype=np.float32)
    Weq_np = np.asarray(Weq, dtype=np.float32)

    inv_tau = 1.0 / tau
    inv_tauv = 1.0 / tauv
    eye_mask = 1.0 - jnp.eye(n)
    vels_const = None if args.varying_speed else jnp.full((steps,), v_default, dtype=jnp.float32)

    print(f"Saving Figure 6 (alpha_J, alpha_W) sweep outputs to: {output_dir}")
    print(
        f"init_mode={args.init_mode} | L={L:.2f}, v={v_default:.3f}, dt={dt}, "
        f"etaJ={etaJ:.1e}, etaW={etaW:.1e}, chunks={chunks}x{steps}"
    )
    print(f"Grid: {len(alphaJ_indices)} alpha_J x {len(alphaW_indices)} alpha_W")

    for i in alphaJ_indices:
        alphaJ = float(alphaJ_vals[i])
        for j in alphaW_indices:
            alphaW = float(alphaW_vals[j])
            run_dir = output_dir / f"alphaJ-{i}_alphaW-{j}"
            run_dir.mkdir(parents=True, exist_ok=True)
            final_state_path = run_dir / "final_state.npz"

            if args.skip_existing and final_state_path.exists():
                hist_path = run_dir / "learning_history.npz"
                if hist_path.exists():
                    h = np.load(hist_path, allow_pickle=True)
                    final_corr_ff[i, j] = float(h["corr_ff"][-1])
                    final_corr_rec[i, j] = float(h["corr_rec"][-1])
                    final_j_max[i, j] = float(h["j_max"][-1])
                    final_w_max[i, j] = float(h["w_max"][-1])
                    chunks_done_grid[i, j] = int(h["chunks"][-1])
                print(f"[alphaJ-{i}_alphaW-{j}] Skipping existing run.")
                continue

            run_seed = args.seed + i * len(alphaW_vals) + j
            rng = np.random.default_rng(run_seed)

            vel_std = 0.0
            avg_win = 0
            v_eq = v_default
            if args.varying_speed:
                vels_host, v_eq, vel_std, avg_win = _generate_varying_speed_profile(
                    total_steps=steps * chunks,
                    dt=dt,
                    m=m,
                    tau=tau,
                    tauv=tauv,
                    std_u=std_U,
                    rng=rng,
                )
            else:
                vels_host = None

            run_params = dict(sim_params)
            run_params.update(
                {
                    "alphaJ_idx": i,
                    "alphaW_idx": j,
                    "alphaJ": alphaJ,
                    "alphaW": alphaW,
                    "v": v_eq,
                    "vel_std": vel_std,
                    "avg_win": avg_win,
                    "run_seed": run_seed,
                }
            )
            np.save(run_dir / "sim_params.npy", run_params)

            # Initialize state and weights
            init_scale = max(0.1, J0)
            if from_stable:
                J = jnp.array(Jeq, dtype=jnp.float32)
                W = jnp.array(Weq, dtype=jnp.float32)
                U = J[:, :1]
                V = J[:, -6:-5] * m
            else:
                U = jnp.asarray(rng.random((n, 1)), dtype=jnp.float32)
                V = jnp.asarray(rng.random((n, 1)), dtype=jnp.float32)
                J = jnp.asarray(
                    np.maximum(rng.standard_normal((n, n)), 0.0) * init_scale,
                    dtype=jnp.float32,
                )
                W = (
                    jnp.asarray(
                        np.maximum(rng.standard_normal((n, n)), 0.0) * 0.01 * init_scale,
                        dtype=jnp.float32,
                    )
                    * eye_mask
                )

            x = jnp.asarray(0.0, dtype=jnp.float32)

            # Warm-up stabilization when starting from equilibrium
            if from_stable and args.stab_steps > 0:
                stab_learning_params = (
                    dt,
                    betaJ,
                    betaW,
                    0.0,
                    0.0,
                    input_std,
                    L,
                    v_eq,
                    0.0,
                    R0,
                    alphaJ,
                    alphaW,
                )
                v_stab = jnp.full(
                    (args.stab_steps,),
                    float(vels_host[0]) if vels_host is not None else v_eq,
                    dtype=jnp.float32,
                )
                U, V, J, W, x = _run_learning_ff_and_rec_jit(
                    U,
                    V,
                    J,
                    W,
                    x,
                    v_stab,
                    inv_tau,
                    inv_tauv,
                    m,
                    k,
                    g,
                    gain,
                    stab_learning_params,
                    pos,
                    args.stab_steps,
                )

            learning_params = (
                dt,
                betaJ,
                betaW,
                etaJ,
                etaW,
                input_std,
                L,
                v_eq,
                av,
                R0,
                alphaJ,
                alphaW,
            )

            chunk_ids = np.arange(chunks + 1, dtype=np.int32)
            time_s = chunk_ids.astype(np.float64) * steps * dt
            corr_ff_hist = np.full(chunks + 1, np.nan, dtype=np.float64)
            corr_rec_hist = np.full(chunks + 1, np.nan, dtype=np.float64)
            j_max_hist = np.full(chunks + 1, np.nan, dtype=np.float64)
            w_max_hist = np.full(chunks + 1, np.nan, dtype=np.float64)

            J_np = np.asarray(J, dtype=np.float32)
            W_np = np.asarray(W, dtype=np.float32)
            sorted_J0, idx_sort0 = sort_connectivity_matrix(J_np)
            corr_ff_hist[0] = _safe_corrcoef(sorted_J0, Jeq_np)
            corr_rec_hist[0] = _safe_corrcoef(W_np[np.ix_(idx_sort0, idx_sort0)], Weq_np)
            j_max_hist[0] = float(J_np.max())
            w_max_hist[0] = float(W_np.max())

            np.savez_compressed(
                run_dir / "snapshot_0000.npz",
                J_ff=J_np,
                W_rec=W_np,
                chunk=0,
                time_s=0.0,
                corr_ff=corr_ff_hist[0],
                corr_rec=corr_rec_hist[0],
                params=run_params,
            )

            t_start = time.perf_counter()
            chunks_completed = 0
            idx_sort = idx_sort0

            desc = f"aJ[{i}]={alphaJ:.2e}, aW[{j}]={alphaW:.2e}"
            pbar = tqdm(range(1, chunks + 1), desc=desc)
            for c in pbar:
                if vels_host is not None:
                    v_chunk = jnp.asarray(vels_host[(c - 1) * steps : c * steps], dtype=jnp.float32)
                else:
                    v_chunk = vels_const

                U, V, J, W, x = _run_learning_ff_and_rec_jit(
                    U,
                    V,
                    J,
                    W,
                    x,
                    v_chunk,
                    inv_tau,
                    inv_tauv,
                    m,
                    k,
                    g,
                    gain,
                    learning_params,
                    pos,
                    steps,
                )

                J_np = np.asarray(J, dtype=np.float32)
                W_np = np.asarray(W, dtype=np.float32)
                sorted_J, idx_sort = sort_connectivity_matrix(J_np)
                sorted_W = W_np[np.ix_(idx_sort, idx_sort)]

                cff = _safe_corrcoef(sorted_J, Jeq_np)
                crec = _safe_corrcoef(sorted_W, Weq_np)

                corr_ff_hist[c] = cff
                corr_rec_hist[c] = crec
                j_max_hist[c] = float(J_np.max())
                w_max_hist[c] = float(W_np.max())
                chunks_completed = c

                pbar.set_postfix(
                    cff=f"{cff:.3f}",
                    crec=f"{crec:.3f}",
                    Jmax=f"{j_max_hist[c]:.2e}",
                    Wmax=f"{w_max_hist[c]:.2e}",
                )

                if args.save_every > 0 and (c % args.save_every == 0 or c == chunks):
                    np.savez_compressed(
                        run_dir / f"snapshot_{c:04d}.npz",
                        J_ff=J_np,
                        W_rec=W_np,
                        chunk=c,
                        time_s=float(time_s[c]),
                        corr_ff=cff,
                        corr_rec=crec,
                        params=run_params,
                    )

                if (
                    from_stable
                    and args.early_stop_corr > 0.0
                    and (
                        (np.isnan(cff) or cff < args.early_stop_corr)
                        and (np.isnan(crec) or crec < args.early_stop_corr)
                    )
                ):
                    pbar.write(
                        f"[{desc}] Early stop at chunk {c} (cff={cff:.3f}, crec={crec:.3f})."
                    )
                    break

            elapsed = time.perf_counter() - t_start

            np.savez_compressed(
                final_state_path,
                J_ff=np.asarray(J, dtype=np.float32),
                W_rec=np.asarray(W, dtype=np.float32),
                U=np.asarray(U, dtype=np.float32),
                V=np.asarray(V, dtype=np.float32),
                x=float(x),
                idx_sort=np.asarray(idx_sort, dtype=np.int32),
                chunks_completed=chunks_completed,
                time_s=float(time_s[chunks_completed]),
                elapsed_wall_s=elapsed,
                params=run_params,
            )

            np.savez_compressed(
                run_dir / "learning_history.npz",
                chunks=chunk_ids[: chunks_completed + 1],
                time_s=time_s[: chunks_completed + 1],
                corr_ff=corr_ff_hist[: chunks_completed + 1],
                corr_rec=corr_rec_hist[: chunks_completed + 1],
                j_max=j_max_hist[: chunks_completed + 1],
                w_max=w_max_hist[: chunks_completed + 1],
                params=run_params,
            )

            final_corr_ff[i, j] = corr_ff_hist[chunks_completed]
            final_corr_rec[i, j] = corr_rec_hist[chunks_completed]
            final_j_max[i, j] = j_max_hist[chunks_completed]
            final_w_max[i, j] = w_max_hist[chunks_completed]
            chunks_done_grid[i, j] = chunks_completed

            # Update top-level 2D sweep summary after every grid point
            np.savez_compressed(
                summary_path,
                alphaJ_vals=alphaJ_vals,
                alphaW_vals=alphaW_vals,
                final_corr_ff=final_corr_ff,
                final_corr_rec=final_corr_rec,
                final_j_max=final_j_max,
                final_w_max=final_w_max,
                chunks_completed=chunks_done_grid,
                params=sim_params,
            )

            print(
                f"[{desc}] {chunks_completed}/{chunks} chunks in {elapsed:.1f}s | "
                f"corr_FF={final_corr_ff[i, j]:.4f}, corr_REC={final_corr_rec[i, j]:.4f}"
            )


if __name__ == "__main__":
    main()